# Copy to .env and fill in. Never commit the real .env.

# Database
DB_USERNAME=krishi
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# JWT signing key, at least 32 characters (e.g. openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_MINUTES=1440

# First admin account, created on startup if it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Fill the database with demo villages, machines, workers and bookings on first start.
# The demo seeker / provider / specialist accounts use DEMO_PASSWORD.
SEED_DEMO_DATA=true
DEMO_PASSWORD=demo1234

# A provider has this long to accept a booking request before the expiry job releases it
BOOKING_PENDING_MINUTES=120
EXPIRY_CHECK_MS=30000

# Road distance. The public OSRM demo server needs no key but is rate limited; point this to your
# own OSRM for real traffic. If it fails, the app falls back to straight-line distance.
ROUTING_ENABLED=true
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=2500
ROUTING_MAX_DESTINATIONS=25

# Browser origins allowed to call the API. Add your public URL when the app runs behind a
# reverse proxy or on a domain, e.g. https://krishi.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
