    {
      "name": "Equipment & location",
      "item": [
        {
          "name": "Nearby equipment (road distance)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment?lat={{lat}}&lng={{lng}}&radiusKm=25&sort=distance&page=0&size=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lng",
                  "value": "{{lng}}"
                },
                {
                  "key": "radiusKm",
                  "value": "25"
                },
                {
                  "key": "sort",
                  "value": "distance"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "12"
                }
              ]
            },
            "description": "Pre-filtered with a bounding box in MySQL, then the nearest N are sent to OSRM. distanceSource is ROAD or STRAIGHT_LINE.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('has distance info', () => pm.expect(res.content[0]).to.have.property('distanceSource'));",
                  "if (res.content.length) pm.collectionVariables.set('equipmentId', res.content[0].id);"
                ]
              }
            }
          ]
        },
