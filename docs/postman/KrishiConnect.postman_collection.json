            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Shivanna K\",\n  \"phone\": \"9876501234\",\n  \"password\": \"farm1234\",\n  \"role\": \"SEEKER\",\n  \"village\": \"Mandya\",\n  \"district\": \"Mandya\",\n  \"latitude\": 12.5223,\n  \"longitude\": 76.897,\n  \"preferredLang\": \"kn\"\n}"
